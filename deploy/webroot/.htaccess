# ============================================================================
#  Rapid Tech Solutions — WEB ROOT .htaccess
#
#  This file belongs at the DOCUMENT ROOT (public_html/), NOT in the theme
#  folder. The theme's own .htaccess only ever applied inside
#  /wp-content/themes/rapidtech-theme/, which is why none of the canonical
#  redirects or security headers were reaching the actual site.
#
#  It contains the standard WordPress block. If your current root .htaccess
#  has extra rules from a plugin (caching, security, CDN), merge them in
#  rather than overwriting blindly — and always keep a copy of the original.
# ============================================================================

# ---------------------------------------------------------------- MIME types
<IfModule mod_mime.c>
    AddType image/webp                  .webp
    AddType image/svg+xml               .svg
    AddType font/woff2                  .woff2
    AddType video/mp4                   .mp4
</IfModule>

# ------------------------------------------------------------------ security
Options -Indexes
ServerSignature Off

# Block access to files that should never be served.
<FilesMatch "(^\.|composer\.(json|lock)|\.(md|sql|log|bak|dist|ini|sh|yml|yaml)$)">
    Require all denied
</FilesMatch>

# The theme's PHP partials are includes, not pages.
RedirectMatch 404 ^/wp-content/themes/rapidtech-theme/(inc|tools)/

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # X-XSS-Protection is deprecated and can introduce vulnerabilities of its
    # own in older browsers. Removed deliberately — do not add it back.
    Header always unset X-XSS-Protection

    Header append Vary Accept-Encoding
</IfModule>

# =========================================================== canonical URLs =
# Every page must resolve at exactly one URL. Without this the site answers on
# http/https x www/apex — four addresses per page — which is what produced the
# "Duplicate without user-selected canonical" reports in Search Console.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.rapidtechsolutions.au%{REQUEST_URI} [R=301,L]

# 2. Force the www host (matches every canonical tag and the sitemap).
RewriteCond %{HTTP_HOST} !^www\.rapidtechsolutions\.au$ [NC]
RewriteRule ^ https://www.rapidtechsolutions.au%{REQUEST_URI} [R=301,L]

# ------------------------------------------- consolidated suburb pages (301)
# 35 near-duplicate suburb pages and 14 postcode pages were 83% identical to
# one another. They now live as sections on ten substantial pages. Keep these
# rules permanently: they carry the existing link equity across.

RedirectMatch 301 ^/computer-repairs-(cranbourne-east|cranbourne-north|cranbourne-west|botanic-ridge|junction-village|devon-meadows|sandhurst|clyde|clyde-north|lynbrook|lyndhurst)/?$ https://www.rapidtechsolutions.au/computer-repairs-cranbourne/
RedirectMatch 301 ^/computer-repairs-(narre-warren-south|hampton-park)/?$                                   https://www.rapidtechsolutions.au/computer-repairs-narre-warren/
RedirectMatch 301 ^/computer-repairs-(noble-park|keysborough|springvale)/?$                                 https://www.rapidtechsolutions.au/computer-repairs-dandenong/
RedirectMatch 301 ^/computer-repairs-(langwarrin|pearcedale)/?$                                             https://www.rapidtechsolutions.au/computer-repairs-frankston/
RedirectMatch 301 ^/computer-repairs-(skye)/?$                                                              https://www.rapidtechsolutions.au/computer-repairs-carrum-downs/
RedirectMatch 301 ^/computer-repairs-(carrum|bonbeach)/?$                                                   https://www.rapidtechsolutions.au/computer-repairs-patterson-lakes/
RedirectMatch 301 ^/computer-repairs-(chelsea-heights|edithvale|aspendale)/?$                               https://www.rapidtechsolutions.au/computer-repairs-chelsea/
RedirectMatch 301 ^/computer-repairs-(mentone)/?$                                                           https://www.rapidtechsolutions.au/computer-repairs-mordialloc/

RedirectMatch 301 ^/postcode-(3173|3174|3175)/?$   https://www.rapidtechsolutions.au/computer-repairs-dandenong/
RedirectMatch 301 ^/postcode-(3192|3193|3194|3195)/?$ https://www.rapidtechsolutions.au/computer-repairs-mordialloc/
RedirectMatch 301 ^/postcode-3196/?$               https://www.rapidtechsolutions.au/computer-repairs-patterson-lakes/
RedirectMatch 301 ^/postcode-3198/?$               https://www.rapidtechsolutions.au/computer-repairs-seaford/
RedirectMatch 301 ^/postcode-(3199|3200)/?$        https://www.rapidtechsolutions.au/computer-repairs-frankston/
RedirectMatch 301 ^/postcode-3201/?$               https://www.rapidtechsolutions.au/computer-repairs-carrum-downs/

# Wantirna (3152) and Rowville (3178) are ~30km east with no neighbouring page.
RedirectMatch 301 ^/postcode-(3152|3178)/?$        https://www.rapidtechsolutions.au/service-areas/

# Retired duplicates.
RedirectMatch 301 ^/service-area/?$                https://www.rapidtechsolutions.au/service-areas/
RedirectMatch 301 ^/page-privacy/?$                https://www.rapidtechsolutions.au/privacy-policy/

# ------------------------------------------------- drop the .php extension
# /about.php and /about/ both returned 200, so every page had a duplicate.
# WordPress core entry points are excluded — rewriting admin-ajax.php or
# wp-login.php would break the admin outright.
RewriteCond %{REQUEST_URI} !^/(wp-admin|wp-includes|wp-content|wp-json)/ [NC]
RewriteCond %{REQUEST_URI} !^/(index|wp-login|wp-cron|wp-signup|wp-activate|wp-trackback|wp-comments-post|xmlrpc)\.php$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# ============================================================ WordPress ====
# Standard WordPress block. Everything above runs first; WordPress handles
# permalinks (including the trailing slash) from here.

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# ======================================================== end WordPress ====

# --------------------------------------------------------------- compression
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css \
        text/javascript application/javascript application/json application/xml \
        image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
        text/javascript application/javascript application/json application/xml \
        image/svg+xml application/rss+xml
    # woff2 and images are already compressed — re-compressing wastes CPU.
</IfModule>

# ------------------------------------------------------------------- caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                      "access plus 1 month"

    ExpiresByType text/html             "access plus 0 seconds"
    ExpiresByType application/xml       "access plus 1 hour"

    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/gif             "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType video/mp4             "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"

    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Fonts, images and video are content-stable — mark them immutable so
    # browsers stop revalidating them on every navigation.
    <FilesMatch "\.(woff2|jpg|jpeg|png|gif|webp|svg|ico|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# No ErrorDocument directive: WordPress routes unmatched requests through
# index.php and serves its own 404 template with the correct status code.
# Adding one here would shadow that and can produce soft-404s.
